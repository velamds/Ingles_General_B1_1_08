": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le08ob11re2img06.jpg", "audiosrc": "engenn6le08ob11re2aud01", "images": [{"time": "0", "image": "engenn6le08ob11re2img06.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le08ob11re2img06.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: I've decided my room is getting a makeover! I'm going to paint it this weekend. Do you think you could help me?</br>\n<span class=\"strong\">Sally</span>: For sure. What color are you thinking?</br>\n<span class=\"strong\">Vanessa</span>: Well, I haven't picked a color yet but I'm leaning towards an earthy colour. According to feng shui principles, these colors provide a grounding energy. </br>\n<span class=\"strong\">Sally</span>: You'd better not paint your room brown. </br>\n<span class=\"strong\">Vanessa</span>: Why?"}, {"time": "25000", "image": "engenn6le08ob11re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>: That's boring. You ought to paint it something bright! </br>\n<span class=\"strong\">Vanessa</span>: That's not going to help me sleep! I've chosen a few shades. </br>\n<span class=\"strong\">Sally</span>: You have? Let's see. Oh, these aren't boring. You'd better choose this pink. I like it. </br>\n<span class=\"strong\">Vanessa</span>: I'm still deciding. Do you want to see some of the new bed linens I got? I'm thinking about returning this one."}, {"time": "51000", "image": "engenn6le08ob11re2img02.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>: This is nice, you've got to keep it. What are those in that bag?</br>\n<span class=\"strong\">Vanessa</span>: Oh, those are some cushions for my room, have a look.</br>\n<span class=\"strong\">Sally</span>: I'm coming over once this room is finished! It will be the most comfortable ever! Now, let's get painting!</br>\n<span class=\"strong\">Vanessa</span>: Uh, I need to have some caffeine first. Hey, have you heard from Peter?</br>\n<span class=\"strong\">Sally</span>: He's waiting to hear from that PR place."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}]}