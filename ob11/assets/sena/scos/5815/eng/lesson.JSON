]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}, {"id": 3, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "<span class=\"strong\">Vanessa</span>:", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "I've decided I'm going to paint my room this weekend. Do you think you could help me?</br>", "type": "text"}], "correct": false}, {"text": "", "id": 2, "selected": 0, "_data": [{"content": "<span class=\"strong\">Sally</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 3, "selected": 0, "_data": [{"content": "For sure. What color are you going to paint it?</br>", "type": "text"}], "correct": 0}, {"text": "", "id": 4, "selected": 0, "_data": [{"content": "<span class=\"strong\">Vanessa</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 5, "selected": 0, "_data": [{"content": "Well, I haven't picked a color yet but I'm leaning towards a earthy tone. According to feng shui principles, these colors provide a grounding energy.</br> ", "type": "text"}], "correct": 0}, {"text": "", "id": 6, "selected": 0, "_data": [{"content": "<span class=\"strong\">Sally</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 7, "selected": 0, "_data": [{"content": "You'd better not paint your room brown. </br>", "type": "text"}], "correct": true}, {"text": "", "id": 8, "selected": 0, "_data": [{"content": "<span class=\"strong\">Vanessa</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 9, "selected": 0, "_data": [{"content": "Why?</br>", "type": "text"}], "correct": 0}, {"text": "", "id": 10, "selected": 0, "_data": [{"content": "<span class=\"strong\">Sally</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 11, "selected": 0, "_data": [{"content": "That's boring.", "type": "text"}], "correct": 0}, {"text": "", "id": 12, "selected": 0, "_data": [{"content": "You ought to paint it something bright! </br>", "type": "text"}], "correct": true}, {"text": "", "id": 13, "selected": 0, "_data": [{"content": "<span class=\"strong\">Vanessa</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 14, "selected": 0, "_data": [{"content": "That's not going to help me sleep!", "type": "text"}], "correct": 0}, {"text": "", "id": 15, "selected": 0, "_data": [{"content": "I've chosen a few shades. </br>", "type": "text"}], "correct": 0}, {"text": "", "id": 16, "selected": 0, "_data": [{"content": "<span class=\"strong\">Sally</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 17, "selected": 0, "_data": [{"content": "You have?", "type": "text"}], "correct": 0}, {"text": "", "id": 18, "selected": 0, "_data": [{"content": "Oh these aren't boring.", "type": "text"}], "correct": 0}, {"text": "", "id": 19, "selected": 0, "_data": [{"content": "You'd better choose this pink.", "type": "text"}], "correct": true}, {"text": "", "id": 20, "selected": 0, "_data": [{"content": "I like it.</br>", "type": "text"}], "correct": 0}, {"text": "", "id": 21, "selected": 0, "_data": [{"content": "<span class=\"strong\">Vanessa</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 22, "selected": 0, "_data": [{"content": "I'm still deciding. ", "type": "text"}], "correct": 0}, {"text": "", "id": 23, "selected": 0, "_data": [{"content": "Do you want to see some of the new bed linens I got?", "type": "text"}], "correct": 0}, {"text": "", "id": 24, "selected": 0, "_data": [{"content": "I'm thinking about returning this one. </br>", "type": "text"}], "correct": 0}, {"text": "", "id": 25, "selected": 0, "_data": [{"content": "<span class=\"strong\">Sally</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 26, "selected": 0, "_data": [{"content": "This is nice,", "t