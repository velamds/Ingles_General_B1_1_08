{"type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Vanessa Has a Nightmare", "type": "lesson_name"}, {"content": "Picking a Color ", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Identify and provide solutions to problems in a range of social contexts.", "type": "primary"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"content": "engenn6le08ob11re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "makeover", "type": "name"}, {"content": "painting the walls, putting in new furniture to make a place look more attractive", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I've decided to give this room a makeover!", "type": "example"}, {"content": "engenn6le08ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words to review.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "earthy", "type": "name"}, {"content": "looking like earth", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm painting the bedroom an earthy color. ", "type": "example"}, {"content": "engenn6le08ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bed linen", "type": "name"}, {"content": "the sheets and pillowcases for a bed", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You should get white bed linens for this room.", "type": "example"}, {"content": "engenn6le08ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "cushion", "type": "name"}, {"content": "a cloth bag filled with soft material that you put  on a bed, chair or the floor to make it more comfortable", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The cushions over there are for the living room.", "type": "example"}, {"content": "engenn6le08ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "caffeine", "type": "name"}, {"content": "a substance in coffee that makes you feel more active", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I need to have some caffeine.", "type": "example"}, {"content": "engenn6le08ob11aud05", "type": "audio"}]}, {"type": "learning_points", "contents": [{"content": "Offering Advice and Solutions", "type": "heading"}, {"content": "You can offer advice and solutions to people. Remember to offer advice politely. ", "type": "describer"}, {"content": "You ought to paint it an earthy color.", "type": "example"}, {"content": "You should buy more cushions. ", "type": "example"}, {"content": "You need to choose something brighter.", "type": "example"}, {"content": "You'd better give this room a makeover.", "type": "example"}, {"content": "When you talk about what is necessary, you use <span class=\"italic\">have got to</span> and <span class=\"italic\">going to have to</span>.</p>  When you talk about what is advisable, you use <span class=\"italic\">need to</span>, <span class=\"italic\">could</span>, <span class=\"italic\">should</span>, <span class=\"italic\">ought to</span>, and <span class=\"italic\">had better</span>.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Present Perfect vs. Past Simple  ", "type": "heading"}, {"content": "You use the <span class=\"strong\">Present Perfect</span> tense to talk about a finished action or event that is connected to the present in some way.  You use the <span class=\"strong\">Simple Past</span> tense to talk about a finished action or event not necessarily connected to the present.", "type": "describer"}, {"content": "You can use the <span class=\"strong\">Present Perfect</span> tense to talk about experiences.<br/> When you use the <span class=\"strong\">Present Perfect</span> tense, you think about the past and present together. There is some connection between what happened in the past and now.</p> Look at the chart about how to form the <span class=\"strong\">Present Perfect</span> tense:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Form\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Subject\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"To have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past Participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Affirmative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">have</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tried\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Negative\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">have not</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"tried\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "Remember you can use the contracted form when speaking:", "type": "text"}, {"content": "{\"rows\":7,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I have/have not\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"=\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I've/I haven't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She has/has not \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"=\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She's/She hasn't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He has/has not \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"=\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He's/He hasn't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They have/have not \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"=\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They've/They haven't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You have/have not \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"=\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You've/You haven't\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We have/have not \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"=\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We've/We haven't\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "I've decided my room is getting a makeover! (<span class=\"strong\">Present Perfect</span>)", "type": "example"}, {"content": "I haven't picked a color yet.  (<span class=\"strong\">Present Perfect</span>)", "type": "example"}, {"content": "I chose a color - an earthy brown! (<span class=\"strong\">Past Simple</span>)", "type": "example"}, {"content": "I heard from my friend Peter last week. (<span class=\"strong\">Past Simple</span>)", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Present  Simple vs. Present Continuous", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "When you use the Present Continuous tense, you concentrate on the duration of a particular activity. You are aware of the passing of time between the start and the end of the activity. This activity is not permanent.", "type": "text"}, {"content": "The Present Simple describes an action that is seen as complete.", "type": "text"}, {"content": "That's boring. (<span class = \"strong\">Present Simple</span>)", "type": "example"}, {"content": "I need some caffeine first.  (<span class = \"strong\">Present Simple</span>)", "type": "example"}, {"content": "I'm coming over once this room is finished!  (<span class = \"strong\">Present Continuous</span>)", "type": "example"}, {"content": "He's waiting to hear from that PR place. (<span class = \"strong\">Present Continuous</span>)", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "Imagine you are giving your bedroom a makeover. ", "type": "text"}, {"content": "What did you do?", "type": "text"}, {"content": "What are you going to do?", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about what I did.", "type": "text"}, {"content": "I write about what I am doing.", "type": "text"}, {"content": "I write about what is necessary to do.", "type": "text"}]}], "labs": [{"id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "exercises": [{"id": 0, "stimuli_ids": [0], "questions": [], "_data": [{"type": "instructions", "contents": [{"content": "I can offer advice and solutions about healthy habits. ", "type": "Learning Outcomes"}, {"content": "I can talk about what people do or what people are doing.", "type": "Learning Outcomes"}, {"content": "I can discuss experiences I've had or haven't had.", "type": "Learning Outcomes"}, {"content": "What colors make you feel better when you look at them? ", "type": "Free Header Item"}, {"content": "If you could paint your room, what color would you choose?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct", "allowed_attempts": 2, "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}]}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Let's review!", "type": "free_type_text_area"}], "img_path": "", "type": "WLC", "template_override": 1}, {"id": 1, "stimuli_ids": [1], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "te