], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le08ob04re2img02.jpg"}, {"text": "Dear Diary,</br><br/>\nI've concluded that keeping a journal is a good way to help my mind become more at ease. Sally was right! I had a nightmare last night. It was the scariest dream I've had in a while. A man tried to get me and I couldn't run fast enough! I ran frantically through an open field. It was cold and dark. The man got gradually closer and closer. I felt his hand on my shoulder and then ... I woke up!", "id": 1, "time": "100", "image": "engenn6le08ob04re2img02.jpg"}, {"text": "What does this mean? I've read a lot about nightmares online. People say that nightmares happen during REM (rapid eye movement) sleep when most dreaming happens. There are many causes of nightmares, some of which I can relate to. Namely, sleeplessness and anxiety.", "id": 2, "time": "31000", "image": "engenn6le08ob08re2img03.jpg"}, {"text": "Recently, I've had many discussions with Sally and Dr. Coats about my insomnia. I appreciate their help, but I feel like maybe I'm trying too hard to improve my sleep. I'm anxiously waiting for my sleep to improve ... and I think that's making it worse! This is the most frustrating experience!\n</p>\nLove, V", "id": 3, "time": "49500", "image": "engenn6le08ob04re2img02.jpg"}], "audiosrc": "engenn6le08ob08re2aud01", "coverimg": "engenn6le08ob04re2img02.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 2, "title": "", "contents": [{"value": {"images": [], "audiosrc": "engenn6le08ob08re6aud06", "coverimg": "engenn6le08ob08re6img01.jpg"}, "type": "picture"}], "_data": [], "type": "audio", "template_override": 1}, {"id": 3, "title": "", "contents": [{"value": {"images": [{"text": "Writing a Journal Entry <br> <br></li><li> Report about interesting, stressful, or traumatic events or just to write your feelings down. <br>\n</li><li>Start with the phrase \"Dear Diary\".</li><li> Begin with an opening statement.</li><li> Use the Past tense or Present Perfect. tense</li><li> Add details - use adjectives and adverbs.</li><li> End with a closing.", "id": 0, "time": "0", "image": ""}], "video_src": "engenn6le08ob08re3vid01"}, "type": "video"}], "_data": [], "type": "video", "template_override": 1}]}]}